#!/usr/bin/env bash

DISABLE_COLORS=false

_change_color_state() {
  if [ "$DISABLE_COLORS" = true ]; then
    C_DIM=""
    C_INFO=""
    C_WARN=""
    C_ERROR=""
    C_CYAN=""
    C_PATH=""
    C_YPATH=""
    C_RESET=""
  else
    C_DIM=$'\x1b[0;90m'
    C_INFO=$'\x1b[0;1;92m'
    C_WARN=$'\x1b[0;1;93m'
    C_ERROR=$'\x1b[0;1;91m'
    C_CYAN=$'\x1b[0;1;96m'
    C_PATH=$'\x1b[0;1;3;94m'
    C_YPATH=$'\x1b[0;1;3;93m'
    C_RESET=$'\x1b[0m'
  fi
}

[ -n "$NO_COLOR" ] && DISABLE_COLORS=true
_change_color_state

_info() {
  echo -e "${C_DIM}:: ${C_INFO}INFO${C_RESET}${C_DIM} - $1${C_RESET}"
}

_warn() {
  echo -e "${C_DIM}:: ${C_WARN}WARN${C_RESET}${C_DIM} - $1${C_RESET}" >&2
}

_error() {
  echo -e "${C_DIM}:: ${C_ERROR}ERROR${C_RESET}${C_DIM} - $1${C_RESET}" >&2
}

_choose() {
  local -n res=$1
  shift

  local options=("$@")
  local selected=0
  local current=0

  local HIDE_CURSOR=$'\033[?25l'
  local SHOW_CURSOR=$'\033[?25h'

  echo -ne "$HIDE_CURSOR"

  while true; do
    if ((current > 0)); then
      echo -ne "\033[${#options[@]}A"
    fi

    for i in "${!options[@]}"; do
      if ((i == selected)); then
        echo -e "  ${C_CYAN}> ${options[i]}${C_RESET}"
      else
        echo -e "    ${C_DIM}${options[i]}${C_RESET}"
      fi
    done
    current=1

    read -rsn1 key
    if [[ $key == $'\033' ]]; then
      read -rsn2 key
      if [[ $key == "[A" ]]; then
        ((selected--))
        ((selected < 0)) && selected=$((${#options[@]} - 1))
      elif [[ $key == "[B" ]]; then
        ((selected++))
        ((selected >= ${#options[@]})) && selected=0
      fi
    elif [[ $key == "" ]]; then
      break
    fi
  done

  echo -e "$SHOW_CURSOR"
  res=${options[$selected]}
}

_checkCommandExists() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null; then
    return 1
  fi
  return 0
}

_clone_repo() {
  local repository="$1"
  mkdir -p "$(dirname "$MIIRDIR/")" &>/dev/null

  if ! _checkCommandExists "git"; then
    _error "${C_PATH}git${C_DIM} must be installed."
    exit 1
  fi

  _info "Cloning ${C_PATH}$repository${C_DIM} to ${C_PATH}$MIIRDIR"
  echo -e "${C_DIM} Select a protocol:"

  _choose format "HTTPS" "SSH" "abort"
  case $format in
  "HTTPS") git clone "https://github.com/$repository.git" "$MIIRDIR/" ;;
  "SSH") git clone "git@github.com:$repository.git" "$MIIRDIR/" ;;
  "abort") _warn "Cloning aborted." ;;
  esac
}

if ((EUID == 0)); then
  _error "Script must not be executed as ${C_PATH}root${C_DIM}!"
  exit 1
fi

sleep 1
clear

export STEAMPATH="${STEAMPATH:-$HOME/.local/share/Steam}"
export MIIRDIR="${MIIRDIR:-$HOME/.local/share/miir}"
export MIIR_CACHE="${MIIR_CACHE:-$HOME/.cache/miir}"

REPOSITORY="YetAnotherMechanicusEnjoyer/miir"

SKYRIMPATH="$STEAMPATH/steamapps/common/Skyrim Special Edition"
PROTONPATH="$STEAMPATH/steamapps/compatdata/489830"

VORTEX_LINK="https://api.nexusmods.com/vortex/download"
KEIZAAL_LINK="https://keizaal.com/api/launcher"

SKYRIM_APPID="489830"

echo -ne "${C_YPATH}"
if _checkCommandExists "figlet"; then
  figlet -f smslant "Miir"
else
  echo "Miir"
fi
echo -e "${C_RESET}"

_info "${C_PATH}Miir${C_DIM} setup ${C_YPATH}started${C_DIM}..."
echo

if [ ! -d "$MIIRDIR/" ]; then
  _clone_repo "$REPOSITORY"
else
  _warn "${C_PATH}$MIIRDIR/${C_DIM} already exists."
  _choose clone "override" "continue"
  [ $clone == "override" ] && rm -rf "$MIIRDIR" && _clone_repo "$REPOSITORY"
fi

[ ! -d "$MIIRDIR/" ] && _error "${C_PATH}$MIIRDIR/${C_DIM} folder not found." && exit 1

echo -ne "${C_DIM}:: Press ${C_PATH}[ENTER]${C_DIM} to continue.${C_RESET}"
read
echo

[ ! -d "$STEAMPATH" ] && _error "${C_PATH}$STEAMPATH/${C_DIM} folder not found. Specify Steam path via ${C_YPATH}STEAMPATH${C_DIM} variable" && exit 1
[ ! -d "$SKYRIMPATH" ] && _error "${C_PATH}$SKYRIMPATH/${C_DIM} folder not found. Skyrim is not installed." && exit 1
[ ! -d "$PROTONPATH" ] && _error "${C_PATH}$PROTONPATH/${C_DIM} folder not found. You must start Skyrim at least once." && exit 1

source "$MIIRDIR/package_manager.sh"
source "$MIIRDIR/dependencies.sh"

_dependency_handle "protontricks" "curl"

if ! _checkCommandExists "protontricks" || ! _checkCommandExists "protontricks-launch"; then
  _error "Failed to install ${C_PATH}protontricks${C_DIM}. Try installing manually."
  exit 1
fi

source "$MIIRDIR/steamcmd.sh"

_steamcmd_install || {
  _error "Failed to install ${C_PATH}steamcmd${C_DIM}. Try installing manually."
  exit 1
}
_steamcmd_downgrade_keizaal || {
  _error "Failed to downgrade ${C_PATH}Skyrim${C_DIM}. Try downgrading manually."
  exit 1
}

[ ! -d "$MIIR_CACHE" ] && mkdir -p "$MIIR_CACHE"

if ! _checkCommandExists "curl"; then
  _error "Missing ${C_PATH}curl${C_DIM} dependency. Try installing manually."
  exit 1
fi

curl -sSfL "$KEIZAAL_LINK" >"$MIIR_CACHE/keizaal.exe" || {
  _error "Installing ${C_PATH}Keizaal Online Launcher${C_DIM}."
  exit 1
}
curl -sSfL "$VORTEX_LINK" >"$MIIR_CACHE/vortex.exe" || {
  _error "Installing ${C_PATH}Vortex Setup${C_DIM}."
  exit 1
}

protontricks-launch --appid "$SKYRIM_APPID" "$MIIR_CACHE/keizaal.exe"
protontricks-launch --appid "$SKYRIM_APPID" "$MIIR_CACHE/vortex.exe"

KEIZAAL_DESKTOP="$HOME/.local/share/applications/keizaal-online.desktop"
VORTEX_DESKTOP="$HOME/.local/share/applications/keizaal-vortex.desktop"

echo \
  "[Desktop Entry]
Type=Application
Name=Keizaal Online
Exec=protontricks-launch --appid 489830 \"/home/archmagos/.local/share/Steam/steamapps/compatdata/489830/pfx/drive_c/users/steamuser/AppData/Local/Programs/skyrim-rp-launcher/keizaal-online.exe\" %u
MimeType=x-scheme-handler/skyrim-rp;
Terminal=false" >"$KEIZAAL_DESKTOP"
chmod +x "$KEIZAAL_LINK"

echo \
  "[Desktop Entry]
Type=Application
Name=Vortex (Keizaal Online)
Exec=protontricks-launch --appid 489830 \"/home/archmagos/.local/share/Steam/steamapps/compatdata/489830/pfx/drive_c/Program\ Files/Vortex/Vortex.exe\" --disable-gpu --no-sandbox %u
MimeType=x-scheme-handler/nxm;
Terminal=false" >"$VORTEX_DESKTOP"
chmod +x "$VORTEX_LINK"

_info "Installation complete! Install Keizaal Collection on Vortex."
echo -ne "${C_DIM}:: Press ${C_PATH}[ENTER]${C_DIM} to close.${C_RESET}"
read
