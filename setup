#!/usr/bin/env bash

DISABLE_COLORS=false

_change_color_state() {
  if [ "$DISABLE_COLORS" = true ]; then
    C_DIM=""
    C_INFO=""
    C_WARN=""
    C_ERROR=""
    C_CYAN=""
    C_PATH=""
    C_YPATH=""
    C_RESET=""
  else
    C_DIM=$'\x1b[0;90m'
    C_INFO=$'\x1b[0;1;92m'
    C_WARN=$'\x1b[0;1;93m'
    C_ERROR=$'\x1b[0;1;91m'
    C_CYAN=$'\x1b[0;1;96m'
    C_PATH=$'\x1b[0;1;3;94m'
    C_YPATH=$'\x1b[0;1;3;93m'
    C_RESET=$'\x1b[0m'
  fi
}

[ -n "$NO_COLOR" ] && DISABLE_COLORS=true
_change_color_state

_info() {
  echo -e "${C_DIM}:: ${C_INFO}INFO${C_RESET}${C_DIM} - $1${C_RESET}"
}

_warn() {
  echo -e "${C_DIM}:: ${C_WARN}WARN${C_RESET}${C_DIM} - $1${C_RESET}" >&2
}

_error() {
  echo -e "${C_DIM}:: ${C_ERROR}ERROR${C_RESET}${C_DIM} - $1${C_RESET}" >&2
}

_choose() {
  local -n res=$1
  shift

  local options=("$@")
  local selected=0
  local current=0

  local HIDE_CURSOR=$'\033[?25l'
  local SHOW_CURSOR=$'\033[?25h'

  echo -ne "$HIDE_CURSOR"

  while true; do
    if ((current > 0)); then
      echo -ne "\033[${#options[@]}A"
    fi

    for i in "${!options[@]}"; do
      if ((i == selected)); then
        echo -e "  ${C_CYAN}> ${options[i]}${C_RESET}"
      else
        echo -e "    ${C_DIM}${options[i]}${C_RESET}"
      fi
    done
    current=1

    read -rsn1 key
    if [[ $key == $'\033' ]]; then
      read -rsn2 key
      if [[ $key == "[A" ]]; then
        ((selected--))
        ((selected < 0)) && selected=$((${#options[@]} - 1))
      elif [[ $key == "[B" ]]; then
        ((selected++))
        ((selected >= ${#options[@]})) && selected=0
      fi
    elif [[ $key == "" ]]; then
      break
    fi
  done

  echo -e "$SHOW_CURSOR"
  res=${options[$selected]}
}

_checkCommandExists() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null; then
    return 1
  fi
  return 0
}

sleep 1
clear

export STEAMPATH="${STEAMPATH:-$HOME/.local/share/Steam}"
export MIIRDIR="${MIIRDIR:-$HOME/.local/share/miir}"

REPOSITORY="YetAnotherMechanicusEnjoyer/miir"

echo -ne "${C_YPATH}"
if _checkCommandExists "figlet"; then
  figlet -f smslant "Miir"
else
  echo "Miir"
fi
echo -e "${C_RESET}"

_info "${C_PATH}Miir${C_DIM} setup ${C_YPATH}started${C_DIM}..."
echo

if [ ! -d "$MIIRDIR/" ]; then
  mkdir -p "$(dirname "$MIIRDIR/")" &>/dev/null

  if ! _checkCommandExists "git"; then
    _error "${C_PATH}git${C_DIM} must be installed."
    exit 1
  fi

  _info "Cloning ${C_PATH}$REPOSITORY${C_DIM} to ${C_PATH}$MIIRDIR"
  echo -e "\n${C_DIM} Select a protocol:"

  _choose format "HTTPS" "SSH" "Abort"
  case $format in
  "HTTPS") git clone "https://github.com/$REPOSITORY.git" "$MIIRDIR/" ;;
  "SSH") git clone "git@github.com:$REPOSITORY.git" "$MIIRDIR/" ;;
  "Abort") _warn "Cloning aborted." ;;
  esac
else
  _warn "${C_PATH}$MIIRDIR/${C_DIM} already exists."
fi
echo

[ ! -d "$MIIRDIR/" ] && _error "${C_PATH}$MIIRDIR/${C_DIM} folder not found." && exit 1

echo -ne "${C_DIM}:: Press ${C_PATH}[ENTER]${C_DIM} to continue.${C_RESET}"
read
echo

source "$MIIRDIR/package_manager.sh"
